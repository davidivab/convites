APP_NAME=Convites
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convites
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploads de usuario: public (local) | s3 (producción Dokploy)
FILESYSTEM_UPLOAD_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@convites.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Separate Next.js frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:3095

# Bot WhatsApp / MCP (Bearer para /api/bot/v1 — distinto de Sanctum)
CONVITES_BOT_TOKEN=
# Opcional: override del origen de links en respuestas del bot
# CONVITES_BOT_FRONTEND_URL=https://convites.co

# Docker local publish port
APP_PORT=8095

# Nominatim (OpenStreetMap geocoding proxy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Convites/1.0 (https://convites.co; geo@convites.co)"
NOMINATIM_VIEWBOX=-76.20,4.50,-75.30,5.20

# Google OAuth (P42) — redirect debe ser una URL del BACKEND (registrada en Google Cloud Console),
# nunca del front. GOOGLE_FRONTEND_CALLBACK_URL es a donde redirigimos el navegador
# con el codigo de intercambio de un solo uso tras procesar el callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8095/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/google/callback
